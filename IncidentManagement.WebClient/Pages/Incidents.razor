    public class IncidentModel
    {
        public string Title { get; set; } = string.Empty;

        public int StatusId { get; set; }
    }

    public class IncidentStatusDto
    {
        public int StatusId { get; set; }

        public string StatusName { get; set; } = string.Empty;
    }
    public class IncidentPriorityDto
    {
        public int PriorityId { get; set; }
        public string PriorityName { get; set; } = string.Empty;
    }
    public class IncidentRoleDto
    {
        public int RoleId { get; set; }
        public string RoleName { get; set; } = string.Empty;
    }

    public class IncidentCategoryDto
    {
        public int CategoryId { get; set; }
        public string CategoryName { get; set; } = string.Empty;
    }
    public class IncidentPropertyDto
    {
        public int PropertyId { get; set; }
        public string PropertyName { get; set; } = string.Empty;
    }
    private void PreviousPage() { if (HasPrevious) CurrentPage--; }
    // private void NextPage() { if (HasNext) CurrentPage++; }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        SearchTitle = e.Value?.ToString() ?? string.Empty;
        CurrentPage = 1;
    }

    private void ShowModal() => IsModalOpen = true;
    private void CloseModal()
    {
        IsModalOpen = false;
        NewIncident = new Incident();
        IncidentCategoryId = 0;
        SelectedStatusId = 0;
        SelectedPriorityId = 0;
        SelectedRoleId = 0;
        SelectedRole = "";
        FilteredUsersByRole.Clear();
    }

    private async Task SaveIncident()
    {
        if (string.IsNullOrWhiteSpace(NewIncident.Title) || IncidentCategoryId <= 0 ||
            SelectedStatusId <= 0 || SelectedPriorityId <= 0)
        {
            Message = "Enter a title and select a category, status, and priority.";
            return;
        }

        try
        {
            var createIncident = new CreateIncidentRequest(NewIncident.Title.Trim(),
                NewIncident.Description ?? string.Empty, AuthState.CurrentUserId,
                IncidentCategoryId, 1, SelectedStatusId, SelectedPriorityId, SelectedPropertyId);
            var response = await Http.PostAsJsonAsync("api/Incident/create", createIncident);
            if (!response.IsSuccessStatusCode)
            {
                Message = await response.Content.ReadAsStringAsync();
                return;
            }
            Message = "Your incident has been logged successfully.";
            MyIncidents = await Http.GetFromJsonAsync<List<IncidentResponse>>(IncidentsEndpoint) ?? new();
            SyncSelectedStatuses();
            CloseModal();
        }
        catch (HttpRequestException)
        {
            Message = "Unable to submit the incident. Check that the Web API is running.";
        }
    }

    private void SyncSelectedStatuses()
    {
        SelectedStatusIds = new Dictionary<int, int>();

        foreach (var incident in MyIncidents)
        {
            var matchingStatus = IncidentStatuses.FirstOrDefault(
                status => string.Equals(status.StatusName, incident.StatusName, StringComparison.OrdinalIgnoreCase));

            SelectedStatusIds[incident.IncidentId] = matchingStatus?.StatusId
                ?? IncidentStatuses.FirstOrDefault()?.StatusId
                ?? 0;
        }
    }

    private async Task SaveIncidentStatus(int incidentId)
    {
        if (!IsAdmin)
        {
            Message = "Only an administrator can update an incident status.";
            return;
        }

        if (!SelectedStatusIds.TryGetValue(incidentId, out var statusId) || statusId <= 0)
        {
            Message = "Please select a valid incident status.";
            return;
        }

        try
        {
            var request = new UpdateIncidentStatusRequest(incidentId, statusId);
            var response = await Http.PutAsJsonAsync("api/Incident/status", request);

            if (!response.IsSuccessStatusCode)
            {
                Message = await response.Content.ReadAsStringAsync();
                return;
            }

            // Reload from the API so the saved status is displayed immediately.
            MyIncidents = await Http.GetFromJsonAsync<List<IncidentResponse>>(IncidentsEndpoint) ?? new();
            SyncSelectedStatuses();
            Message = $"Status for incident #{incidentId} updated successfully. The resident will see the new status when they refresh their incidents page.";
        }
        catch (HttpRequestException)
        {
            Message = "Unable to update the incident status. Check that the Web API is running.";
        }
    }

    private void EditIncident(Incident incident)
    {
        NewIncident = new Incident
        {
            IncidentId = incident.IncidentId,
            Title = incident.Title,
            Description = incident.Description,
            Status = incident.Status,
            Priority = incident.Priority,
            AssignedTo = incident.AssignedTo,
            CreatedDate = incident.CreatedDate,
        };

        var assignedUser = Users.FirstOrDefault(u => u.Username == incident.AssignedTo);
        if (assignedUser != null)
        {
            SelectedRole = assignedUser.Role;
            FilteredUsersByRole = Users.Where(u => u.Role == SelectedRole).ToList();
        }

        IsModalOpen = true;
    }

    private void AskDeleteConfirmation(int id)
    {
        pendingIncidentId = id;
        var incident = IncidentService.GetIncident(id);
        confirmDialog.Show("Confirm Delete", $"Are you sure you want to delete incident '{incident?.Title}'?");
    }

    private void ConfirmDelete()
    {
        //IncidentService.DeleteIncident(pendingIncidentId);
    }

    private void CancelDelete()
    {
        // No action, just close popup
    }
}
