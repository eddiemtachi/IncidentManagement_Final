    //         && (string.IsNullOrEmpty(FilterStatus) || i.Status == FilterStatus)
    //         && (string.IsNullOrEmpty(FilterPriority) || i.Priority == FilterPriority)
    //         && (string.IsNullOrEmpty(FilterAssignedTo) || i.AssignedTo == FilterAssignedTo)
    //     )
    //     .ToList();

    // private int TotalPages => (int)Math.Ceiling((double)FilteredIncidents.Count / PageSize);
    private bool HasPrevious => CurrentPage > 1;
    //private bool HasNext => CurrentPage < TotalPages;

    // private List<Incident> PagedIncidents => FilteredIncidents
    //     .Skip((CurrentPage - 1) * PageSize)
    //     .Take(PageSize)
    //     .ToList();

    private IncidentModel Model = new();

    private bool IsLoading;
    private List<IncidentResponse> MyIncidents = new();
    private IEnumerable<IncidentResponse> FilteredMyIncidents => MyIncidents.Where(i =>
        (string.IsNullOrWhiteSpace(SearchTitle) || i.Title.Contains(SearchTitle, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(FilterStatus) || i.StatusName == FilterStatus) &&
        (string.IsNullOrWhiteSpace(FilterPriority) || i.PriorityName == FilterPriority) &&
        (string.IsNullOrWhiteSpace(FilterAssignedTo) || i.ReporterName == FilterAssignedTo));
    private string Message = string.Empty;

    private bool IsAdmin => string.Equals(AuthState.CurrentUserRole, "Admin", StringComparison.OrdinalIgnoreCase);
    private string IncidentsEndpoint => IsAdmin ? "api/Incident/all" : "api/Incident/my";
    private Dictionary<int, int> SelectedStatusIds = new();

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        if (!AuthState.IsLoggedIn || string.IsNullOrWhiteSpace(AuthState.AccessToken))
        {
            Message = "Please log in to view your incidents.";
            IsLoading = false;
            return;
        }
        Http.DefaultRequestHeaders.Authorization =
            new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthState.AccessToken);

        try
        {
            MyIncidents = await Http.GetFromJsonAsync<List<IncidentResponse>>(IncidentsEndpoint) ?? new();
            IncidentStatuses = await LookupCacheService.GetIncidentStatusesAsync();
            SyncSelectedStatuses();
            IncidentPriorities = await LookupCacheService.GetIncidentPrioritiesAsync();
            IncidentRoles = await LookupCacheService.GetIncidentRolesAsync();
            IncidentCategories = await LookupCacheService.GetIncidentCategoriesAsync();
            IncidentProperties = await LookupCacheService.GetIncidentPropertiesAsync();

        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            IsLoading = false;
        }
    }

    // private async Task SaveAsync()
    // {
    //     // Replace with your actual save endpoint

    //     var response =
    //     await Http.PostAsJsonAsync(
    //     "api/Incident",
    //     Model);

    //     if (response.IsSuccessStatusCode)
    //     {
    //         Message = "Incident created successfully.";
    //     }
