@page "/incidents"
@using System.Net.Http.Json
@layout DashboardLayout
@using IncidentManagement.Application.Dtos.Requests
@using IncidentManagement.Application.Dtos.Responses
@using IncidentManagement.Shared.Models
@using IncidentManagement.Shared.Services
@using IncidentManagement.WebClient.Components
@using IncidentManagement.WebClient.Services
@using IncidentManagement.WebClient.Interfaces
@inject HttpClient Http
@inject IncidentService IncidentService
@inject AuthState AuthState
@inject UserService UserService
@inject ILookupCacheService LookupCacheService

<ConfirmDialog @ref="confirmDialog"
               OnConfirm="ConfirmDelete"
               OnCancel="CancelDelete" />

<div class="profile-container">
    <h2>Incident Management</h2>

    <!-- Button to open modal -->
    <button class="add-btn" @onclick="ShowModal">➕ Add New Incident</button>

    <!-- Modal Popup -->
    @if (IsModalOpen)
    {
        <div class="modal-overlay">
            <div class="modal-content">
                <h3>Capture New Incident</h3>

                <label>Title</label>
                <input type="text" @bind="NewIncident.Title" />

                <label>Status</label>
                @if (IsLoading)
                {
                    <p>Loading lookups...</p>
                }
                else
                {
                    <select class="form-select" @bind="SelectedStatusId">

                        <option value="0">
                            -- Select Status --
                        </option>
                        @foreach (var status in IncidentStatuses)
                        {
                            <option value="@status.StatusId">
                                @status.StatusName
                            </option>
                        }
                    </select>

                    <label> Incident Category</label>
                    <select class="form-select" @bind="IncidentCategoryId">

                        <option value="0">
                            -- Select Incident Category --
                        </option>
                        @foreach (var Category in IncidentCategories)
                        {
                            <option value="@Category.CategoryId">
                                @Category.CategoryName
                            </option>
                        }
                    </select>
                    /* <select class="form-select" @bind="SelectedPriorityId">

                         <option value="0">
                             -- Select Priority --
                         </option>
                         @foreach (var Priority in IncidentPriorities)
                         {
                             <option value="@Priority.PriorityId">
                                 @Priority.PriorityName
                             </option>
                         }
                     </select>*/

                    <label>Priority</label>
                    <select class="form-select" @bind="SelectedPriorityId">

                        <option value="0">
                            -- Select Priority --
                        </option>
                        @foreach (var Priority in IncidentPriorities)
                        {
                            <option value="@Priority.PriorityId">
                                @Priority.PriorityName
                            </option>
                        }
                    </select>

                    <!-- Role Team dropdown -->
                }

                <label>Address</label>
                <select @bind="SelectedPropertyId">
                    @foreach (var Property in IncidentProperties)
                    {
                        <option value="@Property.PropertyId"> @Property.PropertyName</option>
                    }
                </select>

                <label>Description</label>
                <textarea @bind="NewIncident.Description"></textarea>

                <div class="modal-actions">
                    <button class="cancel-btn" @onclick="CloseModal">Cancel</button>
                    <button class="save-btn" @onclick="SaveIncident">Save</button>
                </div>
            </div>
        </div>
    }

    <!-- Filters -->
    <p class="subtitle">Search, filter, capture, and manage incidents</p>
    <div class="filters">
        <input type="text" placeholder="Search by Title"
               value="@SearchTitle"
               @oninput="OnSearchChanged" />
        <select @bind="FilterStatus">
            <option value="">All Statuses</option>
            <option value="Open">Open</option>
            <option value="Closed">Closed</option>
            <option value="In Progress">In Progress</option>
        </select>
        <select @bind="FilterPriority">
            <option value="">All Priorities</option>
            <option value="Low">Low</option>
            <option value="Medium">Medium</option>
            <option value="High">High</option>
        </select>
        <select @bind="FilterAssignedTo">
            <option value="">All Assignees</option>
            @foreach (var user in Users)
            {
                <option value="@user.Username">@user.Username</option>
            }
        </select>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <p class="subtitle">@Message</p>
    }
    @if (IsLoading)
    {
        <p>Loading your incidents...</p>
    }
    else if (!MyIncidents.Any())
    {

        <p>No incidents have been logged by your account yet.</p>
    }
    else
    {
        <table class="incident-table">
            <thead><tr><th>Incident ID</th><th>Title</th><th>Category</th><th>Severity</th><th>Status</th><th>Priority</th><th>Property</th><th>Date Logged</th></tr></thead>
            <tbody>
                @foreach (var incident in FilteredMyIncidents)
                {
                    <tr>
                        <td>@incident.IncidentId</td>
                        <td>@incident.Title</td>
                        <td>@incident.CategoryName</td>
                        <td>@incident.SeverityName</td>
                        <td>
                            @if (IsAdmin)
                            {
                                <select class="form-select" @bind="SelectedStatusIds[incident.IncidentId]">
                                    @foreach (var status in IncidentStatuses)
                                    {
                                        <option value="@status.StatusId">@status.StatusName</option>
                                    }
                                </select>
                                <button class="save-btn" @onclick="() => SaveIncidentStatus(incident.IncidentId)">Save Status</button>
                            }
                            else
                            {
                                <strong>@incident.StatusName</strong>
                            }
                        </td>
                        <td>@incident.PriorityName</td>
                        <td>@incident.PropertyName</td>
                        <td>@incident.CreatedAt.ToLocalTime().ToString("g")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

