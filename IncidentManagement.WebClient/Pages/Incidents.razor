                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @* @foreach (var incident in PagedIncidents)
            {
             <label>Assigned To</label>
                <select @bind="NewIncident.AssignedTo">
                    @foreach (var user in FilteredUsersByRole)
                    {
                        <option value="@user.Username">@user.Username</option>
                    }
                </select>
                <tr>
                    <td>@incident.IncidentId</td>
                    <td>@incident.Title</td>
                    <td>@incident.Status</td>
                    <td>@incident.Priority</td>
                    <td>@incident.AssignedTo</td>
                    <td data-label="Actions">
                        @if (AuthState.IsLoggedIn && string.Equals(AuthState.CurrentUserRole, "Admin", StringComparison.OrdinalIgnoreCase))
                        {
                            <button class="icon-btn edit" data-tooltip="Edit Incident" @onclick="() => EditIncident(incident)">✏️</button>
                            <button class="icon-btn danger" data-tooltip="Delete Incident" @onclick="() => AskDeleteConfirmation(incident.IncidentId)">❌</button>
                        }
                    </td>
                </tr>
            } *@
    @*  </tbody>
    </table>*@

    <!-- Paging -->
    @* <div class="paging-controls">
        <button @onclick="PreviousPage" disabled="@(!HasPrevious)">Previous</button>
        <span>Page @CurrentPage of @TotalPages</span>
        <button @onclick="NextPage" disabled="@(!HasNext)">Next</button>
    </div> *@
</div>

@code {
    private bool IsModalOpen = false;
    private Incident NewIncident = new();
    private List<User> Users = new();
    private List<string> Roles = new();
    private List<User> FilteredUsersByRole = new();
    private List<IncidentStatusResponse> IncidentStatuses = new();
    private List<IncidentPriorityResponse> IncidentPriorities = new();
    private List<IncidentRoleResponse> IncidentRoles = new();
    private List<IncidentCategoryResponse> IncidentCategories = new();
    private List<IncidentPropertyResponse> IncidentProperties = new();

    private string SearchTitle = "";
    private string FilterStatus = "";
    private string FilterPriority = "";
    private string FilterAssignedTo = "";

    private int CurrentPage = 1;
    private int PageSize = 3;

    private ConfirmDialog confirmDialog;
    private int pendingIncidentId;

    protected override void OnInitialized()
    {
        Users = UserService.Users.ToList();
        Roles = Users.Where(x => x.Role != "Tenant" && x.Role != "Resident").Select(u => u.Role).Distinct().ToList();
        FilteredUsersByRole = new List<User>();
    }

    // Single property for binding
    private string SelectedRole
    {
        get => selectedRole;
        set
        {
            selectedRole = value;
            FilteredUsersByRole = string.IsNullOrEmpty(selectedRole)
                ? new List<User>()
                : Users.Where(u => u.Role == selectedRole).ToList();
        }
    }

    private int IncidentCategoryId { get; set; }
    private int SelectedStatusId { get; set; }
    private int SelectedPriorityId { get; set; }
    private int SelectedRoleId { get; set; }
    private int SelectedCategoryId { get; set; }
    private int SelectedPropertyId { get; set; }

    private string selectedRole = "";

    // private List<Incident> FilteredIncidents =>
    //     IncidentService.GetIncidentsForUser(AuthState.CurrentUser ?? string.Empty, AuthState.CurrentUserRole ?? string.Empty)
    //     .Where(i =>
    //         (string.IsNullOrEmpty(SearchTitle) ||
    //          SearchTitle.Split(' ', StringSplitOptions.RemoveEmptyEntries)
    //                     .Take(3)
