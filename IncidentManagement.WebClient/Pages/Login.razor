@using System.Net.Http.Json
@page "/"
@page "/login"
@using IncidentManagement.Shared.Models
@using IncidentManagement.Shared.Services
@using IncidentManagement.WebClient.Services
@layout MainLayout
@inject NavigationManager NavManager
@inject AuthState AuthState
@inject HttpClient Http

<div class="login-container">
    <div class="login-box">
        <div class="login-header">
            <div class="logo-container">
                <i class="shield-icon">!</i>
            </div>
            <h1 class="app-title">Incident Management System</h1>
            <h3 class="login-subtitle">Login</h3>
        </div>

        <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-row">
                <InputText @bind-Value="loginModel.Email" placeholder="Email or Username" class="form-control" />
            </div>

            <div class="form-row">
                <InputText @bind-Value="loginModel.Password" type="password" placeholder="Password" class="form-control" />
            </div>

            <button type="submit" class="btn-primary">Login</button>
        </EditForm>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error-message">@errorMessage</div>
        }

        <div class="login-links">
            <a href="/signup">Sign Up</a>
            <a href="/forgot-password">Forgot Password?</a>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new LoginModel();
    private string errorMessage = string.Empty;

    // protected override void OnInitialized()
    // {
    //     if (!AuthState.IsLoggedIn)
    //     {
    //         NavManager.NavigateTo("/");
    //     }
    // }

    private async Task HandleLogin()
    {
        // Authenticate against the API and use its signed JWT for subsequent requests.
        try
        {
            var response = await Http.PostAsJsonAsync("api/Auth/login", new { Email = loginModel.Email, Password = loginModel.Password });
            if (!response.IsSuccessStatusCode)
            {
                var serverMessage = await response.Content.ReadAsStringAsync();
                errorMessage = response.StatusCode == System.Net.HttpStatusCode.Unauthorized
                    ? "Invalid email/username or password."
                    : string.IsNullOrWhiteSpace(serverMessage)
                        ? $"Login failed ({(int)response.StatusCode}). Check the Web API configuration."
                        : serverMessage;
                return;
            }
            var result = await response.Content.ReadFromJsonAsync<LoginResponse>();
            if (result == null || string.IsNullOrWhiteSpace(result.AccessToken))
            {
                errorMessage = "The server returned an invalid authentication response.";
                return;
            }
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", result.AccessToken);
            AuthState.Login(result.Username, result.Role, result.AccessToken, result.UserId);
            NavManager.NavigateTo("/home");
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to reach the authentication server.";
        }
    }

    private sealed record LoginResponse(string AccessToken, DateTime ExpiresAtUtc, string Role, int UserId, string Username);

}
